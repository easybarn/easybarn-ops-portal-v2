# Copy to .env.local for local dev. On Vercel, add each of these under Project → Settings → Environment Variables.
# Never commit real values.

# Supabase (same project as the old portal)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shopify Admin API (client-credentials app)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-01

# The Courier Guy (keys from the TCG portal work on this host)
TCG_API_KEY=
TCG_API_BASE=https://api.portal.thecourierguy.co.za

# Purchase order emails to Panel & Pane (Resend; FROM must be on a verified domain)
RESEND_API_KEY=
PO_FROM_EMAIL=Easy Barn <orders@easybarn.co.za>
PO_RECIPIENT_EMAIL=admin@panelandpane.co.za
PO_CC_EMAILS=
PO_REPLY_TO=steven@panelandpane.co.za

# Auto-raise POs for paid orders placed on/after this date (AUTO_PO=off to disable)
AUTO_PO_SINCE=2026-10-13T00:00:00+02:00

# Old portal address for the Takealot / Leroy Merlin / WhatsApp sidebar links
NEXT_PUBLIC_LEGACY_URL=https://your-old-portal.vercel.app
